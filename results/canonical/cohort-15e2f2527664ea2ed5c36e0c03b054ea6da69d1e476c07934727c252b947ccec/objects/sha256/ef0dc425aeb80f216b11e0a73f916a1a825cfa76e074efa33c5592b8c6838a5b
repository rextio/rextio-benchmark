fn __rextio_checked_add(a: i64, b: i64) -> PyResult<i64> {
    a.checked_add(b).ok_or_else(|| pyo3::exceptions::PyOverflowError::new_err("integer overflow"))
}

fn __rextio_checked_rem(a: i64, b: i64) -> PyResult<i64> {
    if b == 0 { return Err(pyo3::exceptions::PyZeroDivisionError::new_err("integer modulo by zero")); }
    let r = a.checked_rem(b).unwrap_or(0);
    Ok(if r != 0 && (r ^ b) < 0 { r + b } else { r })
}


fn rextio_call_python_runtime(
    py: Python<'_>,
    module_name: &str,
    ordinal: usize,
    args: &Bound<'_, PyTuple>,
    kwargs: Option<&Bound<'_, PyDict>>,
) -> PyResult<Py<PyAny>> {
    let registry = PyModule::import(py, "rextio.runtime.original_registry")?;
    let target = registry.getattr("resolve_runtime_original")?.call1((module_name, ordinal))?;
    let value = target.call(args, kwargs)?;
    Ok(value.unbind())
}

#[allow(unused_variables)]
#[pyfunction]
fn tensorflow_case__workload__inference<'py>(py: pyo3::Python<'py>, x: pyo3::Bound<'py, pyo3::types::PyAny>, weight: pyo3::Bound<'py, pyo3::types::PyAny>, bias: pyo3::Bound<'py, pyo3::types::PyAny>, depth: i64, phase: i64) -> PyResult<pyo3::Bound<'py, pyo3::types::PyAny>> {
    let x = rextio_tensorflow_runtime::extract_f32_cpu_2d(py, &x)?;
    let weight = rextio_tensorflow_runtime::extract_f32_cpu_2d(py, &weight)?;
    let bias = rextio_tensorflow_runtime::extract_f32_cpu_1d(py, &bias)?;
    let mut transposed = rextio_tensorflow_runtime::transpose(&weight)?;
    let mut hidden = rextio_tensorflow_runtime::matmul(&x, &transposed)?;
    hidden = rextio_tensorflow_runtime::relu(&hidden)?;
    for layer in 0..depth {
        if __rextio_checked_rem(__rextio_checked_add(layer, phase)?, 2)? == 0 {
            hidden = rextio_tensorflow_runtime::sigmoid(&hidden)?;
        } else {
            hidden = rextio_tensorflow_runtime::relu(&hidden)?;
        }
        hidden = rextio_tensorflow_runtime::tanh(&hidden)?;
    }
    let mut probabilities = rextio_tensorflow_runtime::softmax_axis1(&(rextio_tensorflow_runtime::add(&hidden, &bias)?))?;
    return Ok(rextio_tensorflow_runtime::materialize_tensor(py, rextio_tensorflow_runtime::argmax_axis1(&probabilities)?)?);
}

