    let feature_b = rextio_tensorflow_runtime::extract_f32_cpu_1d(py, &feature_b)?;
    let head_w = rextio_tensorflow_runtime::extract_f32_cpu_2d(py, &head_w)?;
    let head_b = rextio_tensorflow_runtime::extract_f32_cpu_1d(py, &head_b)?;
